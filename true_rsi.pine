//@version=6
indicator("True RSI", "True RSI | MisinkoMaster", overlay = false)
/////////////////////////////////////////////////////////////////////
//Import Libaries
import TradingView/ta/13
/////////////////////////////////////////////////////////////////////
//Get User Defined Inputs
src = input.source(close, "Source",
     group = "True RSI | MisinkoMaster")
len = input.int(21, "Lookback Period", step = 1, minval = 2,
     tooltip = "Changes the lookback for the calculation.",
     group = "True RSI | MisinkoMaster")


ut = input.int(50, "Long Treshold", step = 1,
     tooltip = "Changes the Upper Treshold for RSI Longs",
     group = "Tresholds")
lt = input.int(50, "Short Treshold", step = 1,
     tooltip = "Changes the Lower Treshold for RSI Shorts",
     group = "Tresholds")

obt = input.int(80, "Overbought Treshold", step = 1, minval = 55,
     tooltip = "Changes the Overbought Treshold for catching low value zones",
     group = "Tresholds")
ost = input.int(20, "Oversold Treshold", step = 1, maxval = 45,
     tooltip = "Changes the Oversold Treshold for catching high value zones",
     group = "Tresholds")

//Webhook Alerts Inputs
enableAlerts = input.bool(true, "Enable BUY/SELL Alerts",
     tooltip = "Fires an alert() with a JSON payload (webhook-ready) whenever a BUY or SELL signal appears.",
     group = "Webhook Alerts")
alertBuyMsg = input.string("BUY", "Buy Signal Label",
     tooltip = "Value sent in the 'signal' field of the webhook JSON payload for longs.",
     group = "Webhook Alerts")
alertSellMsg = input.string("SELL", "Sell Signal Label",
     tooltip = "Value sent in the 'signal' field of the webhook JSON payload for shorts.",
     group = "Webhook Alerts")
/////////////////////////////////////////////////////////////////////
//Calculations
[up, dn] = ta.aroon(len)

gain = math.max(src-src[1], 0)
loss = math.abs(math.min(src-src[1], 0))

tg = 0.0
tl = 0.0
for i = 0 to len-1
    tg += gain[i]*up[i]
    tl += loss[i]*dn[i]
tg := tg/len
tl := tl/len

trs = tg/tl
trsi = 100 - 100 / (1+trs)
c = trsi-trsi[1]
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//Trend Logic
var trend = 0

L = trsi > ut
S = trsi < lt

if L
    trend := 1
if S
    trend := -1

//Signal events (trend flip)
buySignal = trend == 1 and trend[1] != 1
sellSignal = trend == -1 and trend[1] != -1
////////////////////////////////////////////////////////////////////////////////////////////////////
//Webhook Alerts
//JSON payload ready to be consumed by a webhook endpoint (bots, Discord/Telegram bridges, etc.)
buildAlertPayload(string signal) =>
    '{"signal":"' + signal +
     '","ticker":"' + syminfo.ticker +
     '","exchange":"' + syminfo.prefix +
     '","interval":"' + timeframe.period +
     '","price":' + str.tostring(close, format.mintick) +
     ',"trsi":' + str.tostring(trsi, "#.##") +
     ',"time":"' + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ssZ", "UTC") + '"}'

if enableAlerts and buySignal
    alert(buildAlertPayload(alertBuyMsg), alert.freq_once_per_bar_close)
if enableAlerts and sellSignal
    alert(buildAlertPayload(alertSellMsg), alert.freq_once_per_bar_close)

//Static alert conditions: selectable in the TradingView "Create Alert" dialog.
//Placeholders ({{ticker}}, {{close}}, ...) are filled in by TradingView when the alert fires.
alertcondition(buySignal, "BUY Signal", '{"signal":"BUY","ticker":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{timenow}}"}')
alertcondition(sellSignal, "SELL Signal", '{"signal":"SELL","ticker":"{{ticker}}","interval":"{{interval}}","price":{{close}},"time":"{{timenow}}"}')
////////////////////////////////////////////////////////////////////////////////////////////////////
//Plotting
divergence = 50+c

var col = color.rgb(72, 72, 72)
var colT = color.rgb(72, 72, 72, 50)
if trend == 1
    col := color.rgb(0, 255, 187)
    colT := color.rgb(0, 255, 187, 50)
if trend == -1
    col := color.rgb(255, 0, 157)
    colT := color.rgb(255, 0, 157, 50)

var colD = color.rgb(0, 255, 187, 70)
if divergence > 50
    colD := color.rgb(0, 255, 187, 70)
if divergence < 50
    colD := color.rgb(255, 0, 157, 70)

bc = trsi > obt
sc = trsi < ost

plotshape(buySignal ? src : na, style = shape.labelup, location = location.belowbar, size = size.normal, color = color.rgb(0, 255, 187), display = display.pane, force_overlay = true, text = "𝓛𝓸𝓷𝓰", textcolor = color.rgb(7, 114, 86))
plotshape(sellSignal ? src : na, style = shape.labeldown,location = location.abovebar, size = size.normal,color = color.rgb(255, 0, 157), display = display.pane, force_overlay = true, text = "𝓢𝓱𝓸𝓻𝓽", textcolor = color.rgb(95, 11, 63))

var colOB = trsi > obt ? color.rgb(255, 0, 157, 70) : color.rgb(0, 0, 0, 100)
var colOS = trsi > obt ? color.rgb(255, 0, 157, 70) : color.rgb(0, 0, 0, 100)


bgcolor(colOB, force_overlay = true)
bgcolor(colOB, force_overlay = false)
bgcolor(colOS, force_overlay = true)
bgcolor(colOS, force_overlay = false)

lp = plot(ut, title = "Long Treshhold", color = color.rgb(71, 70, 70), display = display.pane, linewidth = 3)
sp = plot(lt, title = "Short Treshhold", color = color.rgb(71, 70, 70), display = display.pane, linewidth = 3)
obp = plot(obt, title = "OB Treshhold", color = color.rgb(0, 255, 187), display = display.pane, linewidth = 3)
osp = plot(ost, title = "OS Treshhold", color = color.rgb(255, 0, 157), display = display.pane, linewidth = 3)

fill(sp, osp, color.rgb(255, 0, 157, 85))
fill(lp, obp, color.rgb(0, 255, 187, 85))
fill(lp, sp, color.rgb(71, 70, 70, 75))

plotcandle(open, high, low, close, bordercolor = col, color = col, force_overlay = true, display = display.pane)

rsip = plot(trsi, "Self-Correcting RSI | MisinkoMaster", color = col, linewidth = 2)
plot(divergence, "Divergence", color = colD, style = plot.style_histogram, histbase = 50)

fill(rsip, obp, colOB)
fill(rsip, osp, colOS)
